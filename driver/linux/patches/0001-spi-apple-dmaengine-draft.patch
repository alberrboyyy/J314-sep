 	sio_fill_in_locked(siochan);
 
@@ -362,11 +442,15 @@
 {
 	struct sio_data *sio = siochan->host;
 	struct sio_tx *tx = siochan->current_tx;
-	struct sio_coproc_desc *d = tx->siodesc[tx->next];
