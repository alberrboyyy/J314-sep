+/*
+ * DRAFT (sep-touchid, untested on hardware): one-shot transfer.
+ *
+ * One coprocessor descriptor per scatterlist entry, same descriptor fields as
+ * the cyclic path (flag = 1, iova, size). Matches what the project saw macOS
+ * do on SIO channel 0x18 for a 0x568e-byte SPI write: a single MSG_ISSUE with
+ * a single descriptor, then a single MSG_REPORT (docs/dma_spi2_design.md).
+ */
+static struct dma_async_tx_descriptor *sio_prep_slave_sg(
+		struct dma_chan *chan, struct scatterlist *sgl,
+		unsigned int sg_len, enum dma_transfer_direction direction,
+		unsigned long flags, void *context)
+{
+	struct sio_chan *siochan = to_sio_chan(chan);
+	struct sio_tx *siotx;
+	struct scatterlist *sg;
+	unsigned int i;
+
+	if (direction != sio_chan_direction(siochan->no))
+		return NULL;
+	if (!sg_len || sg_len > SIO_MAX_SG)
+		return NULL;
+
+	siotx = kzalloc(struct_size(siotx, siodesc, sg_len), GFP_NOWAIT);
+	if (!siotx)
+		return NULL;
+
+	init_completion(&siotx->done);
+	siotx->cyclic = false;
+	siotx->nperiods = sg_len;
+
+	for_each_sg(sgl, sg, sg_len, i) {
+		struct sio_coproc_desc *d;
+
+		siotx->siodesc[i] = d = sio_alloc_desc(siochan->host);
+		if (!d || !sg_dma_len(sg)) {
+			siotx->vd.tx.chan = &siochan->vc.chan;
+			sio_tx_free(&siotx->vd);
+			return NULL;
+		}
+
+		memset(d, 0, sizeof(*d));	/* slots are reused: clear unk/pad */
+		d->flag = 1; /* same as cyclic path, meaning unknown */
+		d->iova = sg_dma_address(sg);
+		d->size = sg_dma_len(sg);
+	}
+	dma_wmb();
+
+	return vchan_tx_prep(&siochan->vc, &siotx->vd, flags);
+}
+
 static enum dma_status sio_tx_status(struct dma_chan *chan, dma_cookie_t cookie,
 				     struct dma_tx_state *txstate)
 {
@@ -310,7 +372,15 @@
