@@ -499,9 +584,28 @@
 
 		if (tx->ninflight)
 			tx->ninflight--;
-		vchan_cyclic_callback(&tx->vd);
-		if (!sio_fill_in_locked(siochan) && !tx->ninflight)
-			complete(&tx->done);
+
+		if (!tx->cyclic && !tx->terminated) {
+			/*
+			 * DRAFT: one-shot. Reports are assumed to come back in
+			 * issue order (seen on channels 0x18/0x19 under macOS,
+			 * one descriptor per transfer; never seen with several).
+			 */
+			tx->ndone++;
+			if (tx->ndone >= tx->nperiods && !tx->ninflight) {
+				complete(&tx->done);
+				siochan->current_tx = NULL;
+				vchan_cookie_complete(&tx->vd);
+				sio_update_current_tx_locked(siochan);
+			} else {
+				sio_fill_in_locked(siochan);
+			}
+		} else {
+			if (tx->cyclic)
+				vchan_cyclic_callback(&tx->vd);
+			if (!sio_fill_in_locked(siochan) && !tx->ninflight)
+				complete(&tx->done);
+		}
 	}
 	spin_unlock_irqrestore(&siochan->vc.lock, flags);
 }
@@ -715,8 +819,9 @@
 		return -ENOMEM;
 
 	sio->shmem_desc_base = (struct sio_coproc_desc *) (sio->shmem + 56);
-	sio->desc_allocated = devm_kzalloc(sio->dev, SIO_NO_DESC_SLOTS / 32,
-					   GFP_KERNEL);
+	/* DRAFT fix: was SIO_NO_DESC_SLOTS / 32 = 2 bytes for a 64-bit bitmap */
+	sio->desc_allocated = devm_kcalloc(sio->dev, BITS_TO_LONGS(SIO_NO_DESC_SLOTS),
+					   sizeof(unsigned long), GFP_KERNEL);
 	if (!sio->desc_allocated)
 		return -ENOMEM;
 
@@ -829,6 +934,7 @@
 	dma = &sio->dma;
 	dma_cap_set(DMA_PRIVATE, dma->cap_mask);
 	dma_cap_set(DMA_CYCLIC, dma->cap_mask);
+	dma_cap_set(DMA_SLAVE, dma->cap_mask);	/* DRAFT */
 
 	dma->dev = &pdev->dev;
 	dma->device_free_chan_resources = sio_free_chan_resources;
@@ -837,13 +943,16 @@
 	dma->device_terminate_all = sio_terminate_all;
 	dma->device_synchronize = sio_synchronize;
 	dma->device_prep_dma_cyclic = sio_prep_dma_cyclic;
+	dma->device_prep_slave_sg = sio_prep_slave_sg;	/* DRAFT */
 	dma->device_config = sio_device_config;
 
-	dma->directions = BIT(DMA_MEM_TO_DEV);
+	/* DRAFT: odd channels are DEV_TO_MEM (sio_chan_direction), announce it */
+	dma->directions = BIT(DMA_MEM_TO_DEV) | BIT(DMA_DEV_TO_MEM);
