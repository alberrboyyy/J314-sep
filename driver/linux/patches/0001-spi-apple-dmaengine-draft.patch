+	} else if (siotx && siotx->vd.tx.cookie == cookie) {
 		ret = DMA_IN_PROGRESS;
 		periods_residue = siotx->next - siotx->ninflight;
 		while (periods_residue < 0)
@@ -322,7 +392,14 @@
