diff -Naur a/drivers/spi/spi-apple.c b/drivers/spi/spi-apple.c
--- a/drivers/spi/spi-apple.c
+++ b/drivers/spi/spi-apple.c
@@ -9,14 +9,20 @@
 #include <linux/bitfield.h>
 #include <linux/bits.h>
 #include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/dmaengine.h>
 #include <linux/interrupt.h>
 #include <linux/io.h>
+#include <linux/iopoll.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
+#include <linux/sizes.h>
 #include <linux/spi/spi.h>
 
+#include "internals.h"
+
 #define APPLE_SPI_CTRL			0x000
 #define APPLE_SPI_CTRL_RUN		BIT(0)
 #define APPLE_SPI_CTRL_TX_RESET		BIT(2)
@@ -46,6 +52,11 @@
 #define APPLE_SPI_STATUS_RXCOMPLETE	BIT(0)
 #define APPLE_SPI_STATUS_TXRXTHRESH	BIT(1)
 #define APPLE_SPI_STATUS_TXCOMPLETE	BIT(2)
+/*
+ * DRAFT: value macOS writes to STATUS before each SIO-DMA transfer on spi2
+ * (sep-touchid trace C19, spi2.log). Bits 5 and 22 are undocumented.
+ */
+#define APPLE_SPI_STATUS_CLEAR_DMA	0x400023
 
 #define APPLE_SPI_PIN			0x00c
 #define APPLE_SPI_PIN_KEEP_MOSI		BIT(0)
@@ -120,10 +131,20 @@
  */
 #define APPLE_SPI_TIMEOUT_MS		200
 
+/*
+ * DRAFT (sep-touchid, untested): optional SIO DMA, TX-only transfers only.
+ * Below this length PIO is kept (macOS uses DMA for everything on spi2, we
+ * only need it for the ~22 KB sensor patch). Tunable for the first tests.
+ */
+static unsigned int apple_spi_dma_min = 256;
+module_param_named(dma_min, apple_spi_dma_min, uint, 0644);
+MODULE_PARM_DESC(dma_min, "DRAFT: minimum TX-only length sent through SIO DMA");
+
 struct apple_spi {
 	void __iomem      *regs;        /* MMIO register address */
 	struct clk        *clk;         /* bus clock */
 	struct completion done;         /* wake-up from interrupt */
+	struct completion dma_done;     /* DRAFT: wake-up from SIO DMA callback */
 };
 
 static inline void reg_write(struct apple_spi *spi, int offset, u32 value)
@@ -354,11 +375,112 @@
 	*rx_ptr = ((u8 *)*rx_ptr) + bytes_per_word * read;
 }
 
+/* DRAFT: DMA is only used for 8-bit TX-only transfers (RX DMA left for later). */
+static bool apple_spi_can_dma(struct spi_controller *ctlr, struct spi_device *device,
+			      struct spi_transfer *t)
+{
+	return ctlr->dma_tx && t->tx_buf && !t->rx_buf &&
+	       t->bits_per_word == 8 && t->len >= apple_spi_dma_min;
+}
+
+static void apple_spi_dma_callback(void *data)
+{
+	struct apple_spi *spi = data;
+
+	complete(&spi->dma_done);
+}
+
+/*
+ * DRAFT, untested on hardware. Register sequence follows what macOS does on
+ * spi2 for a TX-only SIO transfer (C19 spi2.log): SIO descriptor issued
+ * first, then RXCNT/TXCNT, STATUS clear, CFG mode DMA + FIFO threshold
+ * field = 2, CTRL = RUN | TX_RESET | RX_RESET; completion = SIO report,
+ * then CFG back out of DMA mode and CTRL = 0.
+ */
+static int apple_spi_transfer_one_dma(struct spi_controller *ctlr, struct spi_transfer *t)
+{
+	struct apple_spi *spi = spi_controller_get_devdata(ctlr);
+	struct dma_async_tx_descriptor *desc;
+	unsigned long timeout;
+	dma_cookie_t cookie;
+	u32 fifostat;
+	int ret = 0;
+
+	/* Fail closed: one contiguous burst like macOS, or nothing. */
+	if (t->tx_sg.nents != 1) {
+		dev_err(&ctlr->dev, "DMA: %u sg entries, refusing (want 1)\n",
+			t->tx_sg.nents);
+		return -EINVAL;
+	}
+
+	apple_spi_prep_transfer(spi, t);	/* CLKDIV + SHIFTCFG bits */
+
+	reg_write(spi, APPLE_SPI_CTRL, 0);
+	reg_write(spi, APPLE_SPI_IF_XFER, ~0);
+	reg_write(spi, APPLE_SPI_IF_FIFO, ~0);
+	reg_write(spi, APPLE_SPI_IE_XFER, 0);
+	reg_write(spi, APPLE_SPI_IE_FIFO, 0);
+
+	desc = dmaengine_prep_slave_sg(ctlr->dma_tx, t->tx_sg.sgl, t->tx_sg.nents,
+				       DMA_MEM_TO_DEV, DMA_PREP_INTERRUPT);
+	if (!desc) {
+		/* nothing touched the wire yet: let the core fall back to PIO */
+		t->error |= SPI_TRANS_FAIL_NO_START;
+		return -EBUSY;
+	}
+
+	reinit_completion(&spi->dma_done);
+	desc->callback = apple_spi_dma_callback;
+	desc->callback_param = spi;
+	cookie = dmaengine_submit(desc);
+	ret = dma_submit_error(cookie);
+	if (ret) {
+		t->error |= SPI_TRANS_FAIL_NO_START;
+		return ret;
+	}
+	dma_async_issue_pending(ctlr->dma_tx);
+
+	reg_write(spi, APPLE_SPI_RXCNT, 0);
+	reg_write(spi, APPLE_SPI_TXCNT, t->len);
+	reg_write(spi, APPLE_SPI_STATUS, APPLE_SPI_STATUS_CLEAR_DMA);
+	reg_mask(spi, APPLE_SPI_CFG, APPLE_SPI_CFG_MODE | APPLE_SPI_CFG_FIFO_THRESH,
+		 FIELD_PREP(APPLE_SPI_CFG_MODE, APPLE_SPI_CFG_MODE_DMA) |
+		 FIELD_PREP(APPLE_SPI_CFG_FIFO_THRESH, APPLE_SPI_CFG_FIFO_THRESH_1B));
+	reg_write(spi, APPLE_SPI_CTRL, APPLE_SPI_CTRL_RUN |
+		  APPLE_SPI_CTRL_TX_RESET | APPLE_SPI_CTRL_RX_RESET);
+
+	/* wire time (8 bits per byte) x2, plus the usual margin */
+	timeout = msecs_to_jiffies(2 * DIV_ROUND_UP_ULL(8000ULL * t->len, t->speed_hz) +
+				   APPLE_SPI_TIMEOUT_MS);
+	if (!wait_for_completion_timeout(&spi->dma_done, timeout)) {
+		dev_err(&ctlr->dev, "DMA: no SIO report for %u bytes\n", t->len);
+		dmaengine_terminate_sync(ctlr->dma_tx);
+		ret = -ETIMEDOUT;
+		goto out;
+	}
+
+	/* SIO reported: last bytes may still sit in the TX FIFO / shifter. */
+	ret = readl_relaxed_poll_timeout(spi->regs + APPLE_SPI_FIFOSTAT, fifostat,
+					 !FIELD_GET(APPLE_SPI_FIFOSTAT_LEVEL_TX, fifostat),
+					 1, 1000);
+	if (ret)
+		dev_err(&ctlr->dev, "DMA: TX FIFO not drained (FIFOSTAT %#x)\n", fifostat);
+	else
+		udelay(DIV_ROUND_UP(2 * 8 * USEC_PER_SEC, t->speed_hz));	/* shifter */
+
+out:
+	reg_mask(spi, APPLE_SPI_CFG, APPLE_SPI_CFG_MODE | APPLE_SPI_CFG_FIFO_THRESH,
+		 FIELD_PREP(APPLE_SPI_CFG_MODE, APPLE_SPI_CFG_MODE_IRQ) |
+		 FIELD_PREP(APPLE_SPI_CFG_FIFO_THRESH, APPLE_SPI_CFG_FIFO_THRESH_8B));
+	reg_write(spi, APPLE_SPI_CTRL, 0);
+	return ret;
+}
+
 static int apple_spi_transfer_one(struct spi_controller *ctlr, struct spi_device *device,
 				  struct spi_transfer *t)
 {
 	struct apple_spi *spi = spi_controller_get_devdata(ctlr);
-	bool poll = apple_spi_prep_transfer(spi, t);
+	bool poll;
 	const void *tx_ptr = t->tx_buf;
 	void *rx_ptr = t->rx_buf;
 	unsigned int bytes_per_word;
@@ -368,6 +490,11 @@
 	int retries = 100;
 	int ret = 0;
 
+	if (spi_xfer_is_dma_mapped(ctlr, device, t))
+		return apple_spi_transfer_one_dma(ctlr, t);
+
+	poll = apple_spi_prep_transfer(spi, t);
+
 	if (t->bits_per_word > 16)
 		bytes_per_word = 4;
 	else if (t->bits_per_word > 8)
@@ -454,6 +581,52 @@
 	return ret;
 }
 
+static void apple_spi_release_dma(void *data)
+{
+	struct spi_controller *ctlr = data;
+
+	if (ctlr->dma_tx)
+		dma_release_channel(ctlr->dma_tx);
+	ctlr->dma_tx = NULL;
+}
+
+/*
+ * DRAFT: optional. Without a "tx" entry in "dmas" (every Apple SPI node in
+ * the public DTs today) this is a no-op and the controller stays PIO-only.
+ */
+static int apple_spi_request_dma(struct platform_device *pdev, struct spi_controller *ctlr)
+{
+	struct dma_slave_config cfg = {
+		.direction = DMA_MEM_TO_DEV,
+		.dst_addr_width = DMA_SLAVE_BUSWIDTH_1_BYTE,
+	};
+	struct dma_chan *chan;
+	int ret;
+
+	chan = dma_request_chan(&pdev->dev, "tx");
+	if (IS_ERR(chan)) {
+		ret = PTR_ERR(chan);
+		if (ret == -EPROBE_DEFER)
+			return ret;
+		return 0;	/* no DMA described: PIO only */
+	}
+
+	ret = dmaengine_slave_config(chan, &cfg);
+	if (ret) {
+		dev_warn(&pdev->dev, "SIO DMA config failed (%d), PIO only\n", ret);
+		dma_release_channel(chan);
+		return 0;
+	}
+
+	ctlr->dma_tx = chan;
+	ctlr->can_dma = apple_spi_can_dma;
+	ctlr->max_dma_len = SZ_64K;
+	dev_info(&pdev->dev, "DRAFT: TX DMA via %s for transfers >= %u bytes\n",
+		 dma_chan_name(chan), apple_spi_dma_min);
+
+	return devm_add_action_or_reset(&pdev->dev, apple_spi_release_dma, ctlr);
+}
+
